# Delivering an Enquiry (server-side only, never exposed to the Visitor).
# Set these as Vercel project environment variables in production; copy this
# file to .env for local delivery. Nuxt loads .env and nothing else — a .env.local
# is never read, so the values arrive empty and the send refuses. Mail does not
# leave without all three.
NUXT_RESEND_API_KEY=
NUXT_ENQUIRY_TO=
NUXT_ENQUIRY_FROM=
